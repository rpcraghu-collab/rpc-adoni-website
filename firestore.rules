rules_version = '2';
// RPC Adoni website. Public: create an enquiry, read the site content. Admins (Google sign-in): everything else.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && email() == 'rpcraghu@gmail.com';
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(email())));
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Enquiries from the Contact form.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'course', 'batch', 'message', 'status', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'course', 'batch', 'status', 'source', 'createdAt'])
        && str(request.resource.data.name, 2, 80)
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && str(request.resource.data.course, 1, 120)
        && str(request.resource.data.batch, 1, 60)
        && (!('message' in request.resource.data) || str(request.resource.data.message, 0, 1000))
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
        && request.resource.data.status in ['new', 'called', 'joined', 'not-interested']
        && (!('note' in request.resource.data) || str(request.resource.data.note, 0, 1000))
        && request.resource.data.updatedAt == request.time;
    }

    // Live site content edited in the admin panel (one doc, JSON string).
    match /content/{doc} {
      allow read: if doc == 'site';
      allow write: if isAdmin() && doc == 'site'
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'updatedBy'])
        && str(request.resource.data.json, 2, 200000)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Extra admins (doc id = lower-case Gmail). Only the owner adds or removes them.
    match /admins/{adminEmail} {
      allow read: if isAdmin();
      allow create: if isOwner()
        && adminEmail == adminEmail.lower()
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy'])
        && request.resource.data.addedAt == request.time
        && request.resource.data.addedBy == request.auth.token.email;
      allow delete: if isOwner();
      allow update: if false;
    }
  }
}
